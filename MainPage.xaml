<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PlasticInjectionApp.MainPage"
             Title="فحص توافق القوالب والآلات">

    <ScrollView FlowDirection="RightToLeft">
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="مقارنة ابعاد القالب مع آلة الحقن" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center"/>

            <Entry x:Name="MouldCodeEntry" Placeholder="أدخل كود أو اسم القالب" />

            <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                <Entry Grid.Column="0" x:Name="VMarginEntry" Placeholder="هامش Vmin" Keyboard="Numeric" Text="15"/>
                <Entry Grid.Column="1" x:Name="HMarginEntry" Placeholder="هامش Hmin" Keyboard="Numeric" Text="15"/>
            </Grid>

            <Button Text="فحص التوافق" Clicked="OnCompareClicked" BackgroundColor="#2196F3" TextColor="White"/>

            <BoxView HeightRequest="1" Color="#CCC" />

            <Label x:Name="ResultHeaderLabel" FontSize="16" FontAttributes="Bold" IsVisible="False"/>

            <CollectionView x:Name="ResultsListView">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,5" Padding="10" CornerRadius="8" BorderColor="#DDD">
                            <VerticalStackLayout>
                                <Label Text="{Binding Machine.Name, StringFormat='الآلة: {0}'}" FontAttributes="Bold" FontSize="16"/>
                                <Label Text="{Binding StatusMessage}" FontSize="13" TextColor="{Binding IsCompatible, Converter={StaticResource BoolToColorConverter}}"/>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
